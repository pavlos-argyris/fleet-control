{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleet-control",
  "main": "src/redirect.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": []
  },
  "migrations": [
    {
      "tag": "fleet-events-v1",
      "new_sqlite_classes": [
        "FleetEvents"
      ]
    }
  ]
}
