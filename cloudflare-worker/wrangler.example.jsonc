{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleet-control",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-05",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fleet-control-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "fleet-control-releases"
    },
    {
      "binding": "SERVICE_DOCS",
      "bucket_name": "fleet-control-service-documents"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FLEET_EVENTS",
        "class_name": "FleetEvents"
      }
    ]
  },
  "migrations": [
    {
      "tag": "fleet-events-v1",
      "new_sqlite_classes": [
        "FleetEvents"
      ]
    }
  ]
}
