{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleet-control-fleet",
  "main": "hybrid-fleet/worker.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "FLEET_INITIAL_TRANSFER": "0",
    "FLEET_REHEARSAL_ENABLED": "0",
    "FLEET_BASELINE_TRANSFER": "1",
    "FLEET_SOURCE_DELTA_TRANSFER": "1",
    "FLEET_INITIAL_TRANSFER_RECORD_BYTES": "0",
    "FLEET_INITIAL_TRANSFER_MEDIA_BYTES": "0"
  },
  "d1_databases": [{
    "binding": "FLEET_DB",
    "database_name": "fleet-control-fleet",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "hybrid-fleet/migrations"
  }],
  "r2_buckets": [{ "binding": "FLEET_DOCUMENTS", "bucket_name": "fleet-control-fleet-documents" }]
}
